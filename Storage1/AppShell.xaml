<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="Storage1.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:views="clr-namespace:Storage1.Views"
    Shell.FlyoutBehavior="Disabled"
    Title="Storage1">

    <TabBar>

        <ShellContent Title="ShoppingItems"
                      Icon="grocery_bag.png"
                      ContentTemplate="{DataTemplate views:ShoppingItemPage}"
                      Route="ShoppingItemPage"/>

        <ShellContent Title="Cart"
                       Icon="shopping_cart_add.png"
                      ContentTemplate="{DataTemplate views:ShoppingCartPage}"
                      Route="ShoppingCartPage"/>
        
        
        <ShellContent
        Title="Profile"
        Icon="user.png"
        ContentTemplate="{DataTemplate views:ProfilePage}"
        Route="ProfilePage" />

    </TabBar>

</Shell>
