<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Storage1.Views.ProfilePage"
             Title="Profile">

    <VerticalStackLayout Padding="30" Spacing="20">

        <!-- Profile Image Section -->
        <Frame HorizontalOptions="Center" 
               VerticalOptions="Center" 
               CornerRadius="50" 
               HeightRequest="100" 
               WidthRequest="100" 
               Padding="0" 
               BackgroundColor="#4B164C">
            <Image x:Name="ProfileImage" 
               WidthRequest="100" 
               HeightRequest="100"
               Aspect="AspectFill"/>
        </Frame>
        
        <Button Text="Choose Picture" 
                Clicked="OnChoosePictureClicked"
                BackgroundColor="#4B164C"
                 TextColor="White"
                CornerRadius="20"
                FontSize="14"
                HorizontalOptions="Fill"
                Margin="0,10,0,0"/>


        <!-- Input Fields Section -->

        <Frame CornerRadius="10" 
               BackgroundColor="White" 
               Padding="15" 
               HasShadow="True">
            <VerticalStackLayout Spacing="15">
                <Entry x:Name="NameEntry" 
               Placeholder="Name"
               PlaceholderColor="#999999"
               TextColor="#4B164C"
               FontSize="14"/>
                <Entry x:Name="SurnameEntry" 
               Placeholder="Surname"
                PlaceholderColor="#999999"
                TextColor="#4B164C"
                FontSize="14"/>
                <Entry x:Name="EmailEntry" 
               Placeholder="Email"
                PlaceholderColor="#999999"
                       TextColor="#4B164C"
                       FontSize="14"/>
                <Editor x:Name="BioEntry" Placeholder="Bio"
                HeightRequest="100"
                 PlaceholderColor="#999999"
                       TextColor="#4B164C"
                       FontSize="14"/>
            </VerticalStackLayout>
        </Frame>

        <!-- Save Button -->
        <Button Text="Save Profile" 
                Clicked="OnSaveButtonClicked"
                 BackgroundColor="#4B164C"
                 TextColor="White"
                CornerRadius="20"
                FontSize="14"
                HorizontalOptions="Fill"
                Margin="0,20,0,0"/>

        <!-- Status Label -->
        <Label x:Name="StatusLabel" 
               TextColor="#4B164C"
                 FontSize="14"
               HorizontalOptions="Center"
               Margin="0,10,0,0"/>

        <Button Text="View Profile Information" 
        Clicked="OnViewProfileClicked"
        BackgroundColor="#4B164C"
        TextColor="White"
        CornerRadius="20"
        FontSize="14"
        HorizontalOptions="Fill"
        Margin="0,20,0,0"/>
    </VerticalStackLayout>

</ContentPage>