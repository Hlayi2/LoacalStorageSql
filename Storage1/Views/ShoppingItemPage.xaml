<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Storage1.Views.ShoppingItemPage">
    <ScrollView>
        <StackLayout Margin="20">
            <CollectionView ItemsSource="{Binding ShoppingItems}"
                          SelectionMode="Single"
                          SelectedItem="{Binding SelectedItem, Mode=TwoWay}">
                <CollectionView.ItemsLayout>
                    <GridItemsLayout Orientation="Vertical"
                                   Span="2"
                                   HorizontalItemSpacing="10"
                                   VerticalItemSpacing="10"/>
                </CollectionView.ItemsLayout>

                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <Frame Padding="0"
                               CornerRadius="10"
                               IsClippedToBounds="True"
                               BorderColor="LightGray"
                               HeightRequest="370"
                              
                               Margin="0">
                            <Grid RowDefinitions="Auto,Auto">
                                <!-- Image Container -->
                                <Grid>
                                    <Image Source="{Binding ImageUrl}"
                                           Aspect="AspectFill"
                                           HeightRequest="200"/>

                                    <!-- Discount Badge -->
                                    <Frame BackgroundColor="#90C73E"
                                           Padding="5"
                                           CornerRadius="5"
                                           HorizontalOptions="Start"
                                           VerticalOptions="Start"
                                           Margin="5"
                                           HeightRequest="25"
                                           WidthRequest="25">
                                        <Label Text="{Binding DiscountPercentage, StringFormat='-{0}%'}"
                                               TextColor="White"
                                               FontSize="12"/>
                                    </Frame>

                                    <!-- Quick View Button -->
                                    <Button Text="Quick View"
                                            HorizontalOptions="End"
                                            VerticalOptions="Start"
                                            Margin="5"
                                            BackgroundColor="#333333"
                                            TextColor="White"
                                            FontSize="12"
                                            HeightRequest="34"/>
                                </Grid>

                                <!-- Product Details -->
                                <VerticalStackLayout Grid.Row="1" 
                                                   Padding="10"
                                                   Spacing="5">
                                    <Label Text="{Binding Name}"
                                           FontSize="16"
                                           FontAttributes="Bold"/>

                                    <Label Text="{Binding Description}"
                                           FontSize="14"
                                           TextColor="Gray"/>

                                    <!-- Price Display -->
                                    <StackLayout Orientation="Horizontal">
                                        <Label Text="{Binding OriginalPrice, StringFormat='R{0:N2}'}"
                                               TextDecorations="Strikethrough"
                                               TextColor="Gray"/>
                                        <Label Text="{Binding Price, StringFormat='R{0:N2}'}"
                                               FontAttributes="Bold"
                                               Margin="5,0,0,0"/>
                                    </StackLayout>

                                    <!-- Quantity Controls -->
                                    <Grid ColumnDefinitions="*,Auto,Auto,Auto" 
                                          ColumnSpacing="10">
                                        <Label Text="{Binding StockQuantity, StringFormat='Stock: {0}'}"
                                               VerticalOptions="Center"/>

                                        <Button Text="-"
                                                Grid.Column="1"
                                                WidthRequest="40"
                                                Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.DecrementCommand}"
                                                CommandParameter="{Binding .}"/>

                                        <Label Text="{Binding Quantity}"
                                               Grid.Column="2"
                                               HorizontalOptions="Center"
                                               VerticalOptions="Center"/>

                                        <Button Text="+"
                                                Grid.Column="3"
                                                WidthRequest="40"
                                                Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.IncrementCommand}"
                                                CommandParameter="{Binding .}"/>
                                    </Grid>
                                </VerticalStackLayout>
                            </Grid>
                        </Frame>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

            <Button Text="Add to Cart" 
                    Command="{Binding AddToCartCommand}"
                    Margin="0,20"
                    BackgroundColor="#4B164C"
                    TextColor="White"/>

            <Button Text="View Cart"
                    Clicked="ViewCartClicked"
                    BackgroundColor="#666666"
                    TextColor="White"
                    Margin="0,0,0,20"/>
        </StackLayout>
    </ScrollView>
</ContentPage>