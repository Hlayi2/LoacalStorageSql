<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:local="clr-namespace:Storage1.Views"
             xmlns:converters="clr-namespace:Storage1.Converters"
             x:Class="Storage1.Views.ShoppingCartPage">
    
    <ScrollView>
        <StackLayout Margin="20">
            <!-- Empty Cart Message -->
            <Label Text="Your cart is empty. Start shopping now!"
                   FontSize="Medium"
                   HorizontalOptions="Center"
                   VerticalOptions="Center"
                   IsVisible="{Binding CartItems.Count, Converter={StaticResource IntToBoolConverter}, ConverterParameter=0}"/>

            <!-- Cart Items -->
            <CollectionView ItemsSource="{Binding CartItems}">
                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <Frame Padding="10" Margin="5">
                            <Grid ColumnDefinitions="Auto,*,Auto"
                                  RowDefinitions="Auto,Auto,Auto">

                                <!-- Product Image -->
                                <Image Source="{Binding ShoppingItem.ImageUrl}"
                                       HeightRequest="80"
                                       WidthRequest="80"
                                       Aspect="AspectFit"
                                       Grid.RowSpan="3"/>

                                <!-- Product Details -->
                                <Label Text="{Binding ShoppingItem.Name}"
                                       FontSize="Medium"
                                       FontAttributes="Bold"
                                       Grid.Column="1"/>
                                <Label Text="{Binding ShoppingItem.Description}"
                                       FontSize="Small"
                                       Grid.Column="1"
                                       Grid.Row="1"/>

                                <!-- Quantity and Price -->
                                <StackLayout Orientation="Horizontal"
                                           Grid.Column="1"
                                           Grid.Row="2">
                                    <Label Text="{Binding Quantity, StringFormat='Qty: {0}'}"
                                           VerticalOptions="Center"/>
                                    <Label Text="{Binding ShoppingItem.Price, StringFormat='Price: R{0:N2}'}"
                                           Margin="10,0,0,0"
                                           VerticalOptions="Center"/>
                                </StackLayout>

                                <!-- Remove Button -->
                                <Button Text="Remove"
                                        Command="{Binding Source={RelativeSource AncestorType={x:Type local:ShoppingCartPage}}, Path=BindingContext.RemoveCartItemCommand}"
                                        CommandParameter="{Binding .}"
                                        Grid.Column="2"
                                        Grid.Row="2"/>
                            </Grid>
                        </Frame>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

            <!-- Cart Total -->
            <Label Text="{Binding CartTotal, StringFormat='Total: R{0:N2}'}"
                   FontSize="Large"
                   FontAttributes="Bold"
                   HorizontalOptions="End"
                   Margin="0,20"/>

            <!-- Buttons -->
            <Button Text="Continue Shopping"
                    Clicked="ContinueShoppingClicked"
                    BackgroundColor="#4B164C"
                    TextColor="White"
                    Margin="0,20"/>
            <Button Text="Checkout"
                    Clicked="CheckoutClicked"
                    BackgroundColor="#666666"
                    TextColor="White"
                    Margin="0,10,0,20"/>
            <Button Text="Clear Cart"
                    Clicked="ClearCartClicked"
                    BackgroundColor="#FF0000"
                    TextColor="White"
                    Margin="0,10,0,20"/>
        </StackLayout>
    </ScrollView>
</ContentPage>